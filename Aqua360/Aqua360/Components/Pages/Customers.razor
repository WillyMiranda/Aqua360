@page "/"
@page "/customers"
@using Aqua360.Models
@using Aqua360.Services
@using FluentValidation
@inject ICustomersService CustomersService
@inject IJSRuntime JSRuntime

<PageTitle>Clientes | Aqua360</PageTitle>

<div class="customers-page">
    <header class="page-heading">
        <div>
            <p class="eyebrow">GESTIÓN DE SERVICIO</p>
            <h1>Clientes</h1>
            <p class="page-description">Administra las cuentas de los usuarios del servicio de agua.</p>
        </div>
        <button class="button button-primary" type="button" @onclick="OpenCreateForm">
            <span aria-hidden="true">＋</span> Nuevo cliente
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="notice notice-error" role="alert">
            <span>@_errorMessage</span>
            <button type="button" class="notice-dismiss" aria-label="Cerrar aviso" @onclick="() => _errorMessage = null">×</button>
        </div>
    }

    <section class="summary-grid" aria-label="Resumen de clientes">
        <article class="summary-card summary-total">
            <div class="summary-icon" aria-hidden="true">♧</div>
            <div><p>Total de clientes</p><strong>@_summary.Total</strong></div>
            <span class="summary-caption">Registrados</span>
        </article>
        <article class="summary-card summary-active">
            <div class="summary-icon" aria-hidden="true">✓</div>
            <div><p>Activos</p><strong>@_summary.Active</strong></div>
            <span class="summary-caption">Con servicio</span>
        </article>
        <article class="summary-card summary-inactive">
            <div class="summary-icon" aria-hidden="true">Ⅱ</div>
            <div><p>Inactivos</p><strong>@_summary.Inactive</strong></div>
            <span class="summary-caption">Sin servicio</span>
        </article>
    </section>

    <section class="filters-panel" aria-label="Filtros de clientes">
        <form class="filter-form" @onsubmit="ApplyFilters" @onsubmit:preventDefault>
            <label class="search-field">
                <span>Buscar cliente</span>
                <input type="search" @bind="_searchInput" placeholder="Nombre, cuenta, identificación..." />
            </label>
            <label class="status-field">
                <span>Estado</span>
                <select @bind="_activeFilter">
                    <option value="">Todos los estados</option>
                    <option value="true">Activos</option>
                    <option value="false">Inactivos</option>
                </select>
            </label>
            <button class="button button-secondary" type="submit">Filtrar</button>
            <button class="button button-quiet" type="button" @onclick="ClearFilters">Limpiar</button>
        </form>
    </section>

    <section class="table-card" aria-label="Listado de clientes">
        <div class="table-heading">
            <div>
                <h2>Listado de clientes</h2>
                <p>@_totalCount clientes encontrados</p>
            </div>
            <button class="button button-quiet refresh-button" type="button" @onclick="LoadAsync" disabled="@_isLoading">Actualizar</button>
        </div>

        <div class="table-scroll">
            <table class="customer-table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>N.º de cuenta</th>
                        <th>Identificación</th>
                        <th>Contacto</th>
                        <th>Estado</th>
                        <th><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_isLoading)
                    {
                        <tr><td class="table-message" colspan="6">Cargando clientes...</td></tr>
                    }
                    else if (_customers.Count == 0)
                    {
                        <tr><td class="table-message" colspan="6">No hay clientes para mostrar. Ajusta los filtros o registra un cliente.</td></tr>
                    }
                    else
                    {
                        @foreach (var customer in _customers)
                        {
                            <tr>
                                <td>
                                    <div class="customer-name">@customer.FullName</div>
                                    <div class="customer-subtext">@customer.Address</div>
                                </td>
                                <td><span class="account-number">@customer.AccountNumber</span></td>
                                <td>@customer.Identification</td>
                                <td>
                                    <div>@customer.Phone</div>
                                    @if (!string.IsNullOrWhiteSpace(customer.Email))
                                    {
                                        <div class="customer-subtext">@customer.Email</div>
                                    }
                                </td>
                                <td><span class="status-pill @(customer.IsActive ? "status-active" : "status-inactive")">@(customer.IsActive ? "Activo" : "Inactivo")</span></td>
                                <td>
                                    <div class="row-actions">
                                        <button class="icon-button" type="button" title="Editar cliente" aria-label="Editar @customer.FullName" @onclick="() => OpenEditForm(customer)">Editar</button>
                                        <button class="icon-button icon-danger" type="button" title="Eliminar cliente" aria-label="Eliminar @customer.FullName" @onclick="() => DeleteAsync(customer)">Eliminar</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <footer class="pagination-bar">
            <span>Página @(_totalPages == 0 ? 0 : _page) de @_totalPages</span>
            <div class="pagination-actions">
                <button class="button button-secondary" type="button" @onclick="PreviousPage" disabled="@(_page <= 1 || _isLoading)">Anterior</button>
                <button class="button button-secondary" type="button" @onclick="NextPage" disabled="@(_page >= _totalPages || _isLoading)">Siguiente</button>
            </div>
        </footer>
    </section>
</div>

@if (_showEditor)
{
    <div class="modal-backdrop" role="presentation">
        <section class="customer-dialog" role="dialog" aria-modal="true" aria-labelledby="customer-dialog-title">
            <header class="dialog-header">
                <div>
                    <p class="eyebrow">FICHA DE SERVICIO</p>
                    <h2 id="customer-dialog-title">@(_editingId.HasValue ? "Editar cliente" : "Nuevo cliente")</h2>
                </div>
                <button class="icon-button dialog-close" type="button" aria-label="Cerrar" @onclick="CloseEditor">×</button>
            </header>

            @if (!string.IsNullOrWhiteSpace(_formError))
            {
                <div class="notice notice-error" role="alert">@_formError</div>
            }

            <form class="customer-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
                <label>
                    <span>Número de cuenta *</span>
                    <input @bind="_draft.AccountNumber" maxlength="32" required />
                </label>
                <label>
                    <span>Nombre completo *</span>
                    <input @bind="_draft.FullName" maxlength="160" required />
                </label>
                <label>
                    <span>Identificación *</span>
                    <input @bind="_draft.Identification" maxlength="32" required />
                </label>
                <label class="form-wide">
                    <span>Dirección *</span>
                    <input @bind="_draft.Address" maxlength="255" required />
                </label>
                <label>
                    <span>Teléfono *</span>
                    <input @bind="_draft.Phone" maxlength="32" required />
                </label>
                <label>
                    <span>Correo electrónico</span>
                    <input type="email" @bind="_draft.Email" maxlength="254" />
                </label>
                <label class="active-toggle">
                    <input type="checkbox" @bind="_draft.IsActive" />
                    <span>Cliente activo</span>
                </label>
                <div class="dialog-actions form-wide">
                    <button class="button button-quiet" type="button" @onclick="CloseEditor">Cancelar</button>
                    <button class="button button-primary" type="submit" disabled="@_isSaving">@(_isSaving ? "Guardando..." : "Guardar cliente")</button>
                </div>
            </form>
        </section>
    </div>
}

@code {
    private const int PageSize = 10;
    private List<Customer> _customers = [];
    private CustomerSummary _summary = new();
    private CustomerSaveRequest _draft = new();
    private string _searchInput = string.Empty;
    private string? _appliedSearch;
    private bool? _activeFilter;
    private int? _editingId;
    private int _page = 1;
    private int _totalPages;
    private int _totalCount;
    private bool _isLoading;
    private bool _isSaving;
    private bool _showEditor;
    private string? _errorMessage;
    private string? _formError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var results = await CustomersService.GetPageAsync(_appliedSearch, _activeFilter, _page, PageSize);
            _customers = results.Items.ToList();
            _totalCount = results.TotalCount;
            _totalPages = results.TotalPages;
            _summary = await CustomersService.GetSummaryAsync();
        }
        catch (Exception exception)
        {
            _errorMessage = $"No se pudieron cargar los clientes. Verifica la configuración y conexión de MariaDB. {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _appliedSearch = _searchInput;
        _page = 1;
        await LoadAsync();
    }

    private async Task ClearFilters()
    {
        _searchInput = string.Empty;
        _appliedSearch = null;
        _activeFilter = null;
        _page = 1;
        await LoadAsync();
    }

    private async Task PreviousPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadAsync();
        }
    }

    private async Task NextPage()
    {
        if (_page < _totalPages)
        {
            _page++;
            await LoadAsync();
        }
    }

    private void OpenCreateForm()
    {
        _editingId = null;
        _draft = new CustomerSaveRequest();
        _formError = null;
        _showEditor = true;
    }

    private void OpenEditForm(Customer customer)
    {
        _editingId = customer.Id;
        _draft = new CustomerSaveRequest
        {
            AccountNumber = customer.AccountNumber,
            FullName = customer.FullName,
            Identification = customer.Identification,
            Address = customer.Address,
            Phone = customer.Phone,
            Email = customer.Email,
            IsActive = customer.IsActive
        };
        _formError = null;
        _showEditor = true;
    }

    private void CloseEditor()
    {
        _showEditor = false;
        _formError = null;
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _formError = null;
        try
        {
            await CustomersService.SaveAsync(_editingId, _draft);
            _showEditor = false;
            await LoadAsync();
        }
        catch (ValidationException exception)
        {
            _formError = string.Join(" ", exception.Errors.Select(error => error.ErrorMessage));
        }
        catch (Exception exception)
        {
            _formError = $"No se pudo guardar el cliente. {exception.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteAsync(Customer customer)
    {
        if (!await JSRuntime.InvokeAsync<bool>("aqua360.confirmCustomerDelete", customer.FullName))
        {
            return;
        }

        try
        {
            await CustomersService.DeleteAsync(customer.Id);
            if (_customers.Count == 1 && _page > 1)
            {
                _page--;
            }

            await LoadAsync();
        }
        catch (Exception exception)
        {
            _errorMessage = $"No se pudo eliminar el cliente. {exception.Message}";
        }
    }
}
